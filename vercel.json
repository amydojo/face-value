{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --no-audit --no-fund",
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "experiment/local-optical-comparability": false,
      "feat/fv05-living-trial": false
    }
  },
  "routes": [
    {
      "src": "/calibration/redness/?",
      "dest": "/api/calibration/redness"
    },
    {
      "src": "/demo/?",
      "dest": "/api/demo"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}

# Server-only YouCam API bearer token. Never prefix with VITE_.
YOUCAM_API_KEY=

# Temporary protected engineering token.
# The /youcam-spike gate exchanges this once for a signed Secure, HttpOnly,
# SameSite=Strict cookie with a 30-minute lifetime. The canonical product flow
# never reads this raw value and no browser storage receives it.
YOUCAM_SPIKE_TOKEN=

# Optional engineering-only archive controls. Leave unset or false for the
# canonical product and all shared previews.
VITE_SHOW_DEMO_CONTROLS=false

# Guided capture uses the deterministic in-memory adapter in local development
# and tests. Shared production previews default to the official Camera Kit.
# Set only when a verification environment needs an explicit adapter.
VITE_CAMERA_KIT_MODE=live

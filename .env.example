# Server-only YouCam API bearer token. Never prefix with VITE_.
YOUCAM_API_KEY=

# Temporary protected engineering token.
# The /youcam-spike gate exchanges this once for a signed Secure, HttpOnly,
# SameSite=Strict cookie with a 30-minute lifetime. The canonical product flow
# never reads this raw value and no browser storage receives it.
YOUCAM_SPIKE_TOKEN=

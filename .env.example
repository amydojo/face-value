# Server-only YouCam Skin Analysis bearer token.
# Never prefix this value with VITE_ and never expose it to browser code.
YOUCAM_API_KEY=

# Temporary protected engineering token.
# POST /api/youcam/session exchanges it for a signed Secure, HttpOnly,
# SameSite=Strict cookie with a 30-minute lifetime. The cookie currently uses
# Path=/ so the same protected session can authorize provider, Demo Lab, and
# future internal calibration routes. This is not consumer authentication.
YOUCAM_SPIKE_TOKEN=

# Optional engineering-only Demo Lab controls. Leave false for the ordinary
# consumer journey and shared production behavior.
VITE_SHOW_DEMO_CONTROLS=false

# Compatibility selector for the guided-capture adapter.
# - fixture: deterministic in-memory adapter for local/test verification.
# - live: real guided capture. Current production resolves this to
#   NativeBrowserCameraAdapter, which captures the exact visible first-party
#   <video> frame.
#
# The external Perfect Corp Camera Kit renderer is diagnostic only and is opened
# in development with ?camera-kit-diagnostics=1. This variable does not make
# Camera Kit hdskincare the production camera.
VITE_CAMERA_KIT_MODE=live